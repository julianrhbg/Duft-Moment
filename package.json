{
  "name": "dazwischen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ein kleiner Raum für deinen Duftmoment.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/browser.mjs",
    "setup": "node scripts/setup.mjs",
    "build": "bash scripts/build.sh",
    "dev:hosted": "node scripts/preview-hosted.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "test:intro": "node --test scripts/test-intro.mjs",
    "test:hosting": "node scripts/test-hosted.mjs",
    "test:migration": "node scripts/test-trio-migration.mjs",
    "test:info-ui": "node --experimental-vm-modules scripts/test-info-ui.mjs",
    "test:renderer": "node scripts/test-info-renderer.mjs",
    "test:info": "node scripts/info-browser.mjs",
    "build:info-stills": "node scripts/info-stills.mjs",
    "test:stock": "node scripts/test-stock-migration.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}

